{
  "name": "qaengineer-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "prepare": "husky",
    "init": "@qaengineer run"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "3.5.3",
    "turbo": "^1.13.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
